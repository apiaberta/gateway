# API Aberta Gateway — Environment Variables

# Server
PORT=3000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://localhost:27017/apiaberta-gateway

# JWT
JWT_SECRET=change-me-in-production-to-a-long-random-string

# Service URLs (internal)
FUEL_SERVICE_URL=http://localhost:3001
IPMA_SERVICE_URL=http://localhost:3002
BASE_SERVICE_URL=http://localhost:3003
EV_SERVICE_URL=http://localhost:3004
INE_SERVICE_URL=http://localhost:3005
ANPC_SERVICE_URL=http://localhost:3006
BDP_SERVICE_URL=http://localhost:3008
GEO_SERVICE_URL=http://localhost:3009

# CORS (optional, defaults to *)
# ALLOWED_ORIGINS=https://apiaberta.pt,https://app.apiaberta.pt
